              "options": [
                { "name": "Small", "value": "1", "default": true },
                { "name": "Medium", "value": "2" },
                { "name": "Large", "value": "3" }
              ],
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordPrefHybridDriveOverlay": "1"
