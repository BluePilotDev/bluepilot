    {
      "name": "Lat. Tuning",
      "icon": "../assets/offroad/icon_steering.png",
      "groups": [
        {
          "groupName": "lateralControlsGroup",
          "title": "Lateral Controls:",
          "enableResetButton": true,
          "controls": [
            {
              "type": "toggle",
              "param": "FordPrefHumanTurnDetectionEnable",
              "title": "Enable Human Turn Detection",
              "desc": "Reset steering so you don't fight the wheel making manual turns.",
              "hidden": false,
              "conditions": {
                "git_remote": ["any"],
                "git_branch": []
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningLaneChgFactorHigh",
              "title": "Lane Change Factor High",
              "desc": "Adjust lane change curvature aggressiveness (lower = slower).",
              "hidden": false,
              "min": 0.0,
              "max": 1.0,
              "increment": 0.05,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] }
                ]
              }
            },
            {
              "type": "toggle",
              "param": "FordLatTuningTuningCustomProfile",
              "title": "Use Custom Tuning Profile",
              "desc": "Use custom tuning profile for advanced lateral control",
              "hidden": false,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] }
                ]
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningPCBlendRatio_low_C",
              "title": "Predicted Curvature Blend Ratio Low",
              "desc": "Adjust the blend ratio of predicted curvature in straightaways.",
              "hidden": false,
              "min": 0.0,
              "max": 1.0,
              "increment": 0.05,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningTuningCustomProfile": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningPCBlendRatio_high_C",
              "title": "Predicted Curvature Blend Ratio High",
              "desc": "Adjust the blend ratio of predicted curvature in curves.",
              "hidden": false,
              "min": 0.0,
              "max": 1.0,
              "increment": 0.05,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningTuningCustomProfile": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "toggle",
              "param": "FordLatTuningEnableLanePositioning",
              "title": "Enable Advanced Lane Positioning",
              "desc": "Allows custom lane positioning and lanefull.",
              "hidden": false,
              "conditions": {
                "git_remote": ["any"],
                "git_branch": []
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningCustomPathOffset",
              "title": "In Lane Offset",
              "desc": "Adjusts lane position - left (-) / right (+)",
              "hidden": false,
              "min": -0.5,
              "max": 0.5,
              "increment": 0.01,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningEnableLanePositioning": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "toggle",
              "param": "FordLatTuningEnableLanefullMode",
              "title": "Enable Lane Full Mode",
              "desc": "Enable Auto Lanefull Mode similar to legacy SunnyPilot",
              "hidden": false,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningEnableLanePositioning": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningLCPIDGainUI",
              "title": "Low Curvature PID Gain",
              "desc": "Adjust the gain of the PID controller for low curvature",
              "hidden": false,
              "min": 0.0,
              "max": 10.0,
              "increment": 0.1,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningTuningCustomProfile": "1"
                    }
                  },
                  {
                    "paramValueEquals": {
                      "FordLatTuningEnableLanePositioning": "1"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Utilities",
      "icon": "../assets/offroad/icon_toolbox.png",
      "groups": [
        {
          "groupName": "utilityCommandsGroup",
          "title": "Utility Commands:",
          "enableResetButton": false,
          "controls": [
            {
              "type": "command_button",
              "command": "echo \"Starting process...\" && for i in {1..5}; do echo \"[$(date '+%H:%M:%S')] Processing batch $i/5...\"; sleep 1; echo \"  -> Completed subtask $i\"; sleep 1; done && echo \"All tasks completed successfully!\"",
              "working_dir": "/data/openpilot",
              "title": "Test Command",
              "desc": "Test Command",
              "button_text": "Test Command",
              "confirm": true,
              "confirm_text": "Are you sure you want to run this command?",
              "confirm_button_text": "Run",
              "cancel_button_text": "Cancel",
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "command_button",
              "command": "wget https://raw.githubusercontent.com/tonesto7/op-utilities/main/CommaUtility.sh && chmod +x /data/CommaUtility.sh",
              "working_dir": "/data",
              "title": "Install Comma Utility",
              "desc": "Install Comma Utility",
              "button_text": "Install",
              "confirm": false,
              "hidden": false,
              "OnlyOnCommaDevice": true,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "file_viewer",
              "path": "/data/community/crashes/error.txt",
              "title": "Recent Crashes",
              "desc": "View the crashes file",
              "button_text": "View Error",
              "confirm": false,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "file_viewer",
              "path": "/data/logs/bp_logger/bluepilot.log",
              "title": "BluePilot Log",
              "desc": "View the BluePilot log",
              "button_text": "View Log",
              "confirm": false,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "command_button",
              "command": "ifconfig",
              "working_dir": "/data/openpilot",
              "title": "Get Network Info",
              "desc": "Get network info using ifconfig",
              "button_text": "Get Info",
              "confirm": false,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "command_button",
              "command": "joystick_control.py",
              "working_dir": "/data/openpilot/tools/joystick",
              "title": "Joystick Control",
              "desc": "Joystick Control",
              "button_text": "Start Joystick",
              "confirm": true,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "command_button",
              "command": "tail -f /tmp/launch_log",
              "working_dir": "/data/openpilot",
              "title": "View Launch Log",
              "desc": "View the launch log",
              "button_text": "View Log",
              "confirm": false,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "toggle",
              "param": "GsmMetered",
              "title": "GSM Metered Mode Enabled",
              "desc": "Toggle GSM metered mode",
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "toggle",
              "param": "DisableUpdates",
