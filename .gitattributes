* text=auto eol=lf

# to move existing files into LFS:
# git add --renormalize .
*.onnx filter=lfs diff=lfs merge=lfs -text
openpilot/selfdrive/modeld/models/big_*_tinygrad.pkl filter=lfs diff=lfs merge=lfs -text
openpilot/sunnypilot/modeld_v2/models/*.pkl filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

openpilot/selfdrive/car/tests/test_models_segs.txt filter=lfs diff=lfs merge=lfs -text
openpilot/common/hardware/comma/updater filter=lfs diff=lfs merge=lfs -text

# BluePilot (BPx): BluePilot's own binaries are plain git files, not LFS: BluePilot can't push to
# sunnypilot's LFS server. Scoped to the extensions the LFS rules above claim, so text files keep git's
# own handling.
bluepilot/**/*.png -filter -diff -merge
bluepilot/**/*.gif -filter -diff -merge
bluepilot/**/*.svg -filter -diff -merge
bluepilot/**/*.ttf -filter -diff -merge
bluepilot/**/*.otf -filter -diff -merge
bluepilot/**/*.wav -filter -diff -merge
bluepilot/**/*.onnx -filter -diff -merge
openpilot/selfdrive/assets/bp_themes/** -filter -diff -merge
openpilot/selfdrive/assets/sounds/bluepilot/*.wav -filter -diff -merge
# BluePilot-added images inside upstream asset folders (to move under a BluePilot folder: BluePilotDev/bluepilot#223)
openpilot/selfdrive/assets/icons_mici/settings/car_icon.png -filter -diff -merge
openpilot/selfdrive/assets/images/button_fan.png -filter -diff -merge
openpilot/selfdrive/assets/images/spinner_bluepilot.png -filter -diff -merge
openpilot/selfdrive/assets/offroad/icon_debug.png -filter -diff -merge
openpilot/selfdrive/assets/offroad/icon_flag.png -filter -diff -merge
openpilot/selfdrive/assets/offroad/icon_settings.png -filter -diff -merge
